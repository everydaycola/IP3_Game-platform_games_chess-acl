# this file was AI generated based on Container_infrastructure.md. It might contain mistakes.

### Variables
@baseUrl = http://localhost:8080/api
#@gameId = {{ $random.uuid }}
@gameId = 8496c496-a884-48ed-9bb3-7c3aa50fb8ca

### 1. Create a new chess game
POST {{baseUrl}}/games/{{gameId}}
Content-Type: application/json

{
  "whitePlayerName": "Garry Kasparov",
  "whitePlayerId": "11111111-1111-1111-1111-111111111111",
  "blackPlayerName": "Magnus Carlsen",
  "blackPlayerId": "22222222-2222-2222-2222-222222222222"
}

### 2. Get game details
GET {{baseUrl}}/games/{{gameId}}

### 3. Update player names
PUT {{baseUrl}}/games/{{gameId}}
Content-Type: application/json

{
  "whitePlayerName": "Garry Kasparov",
  "blackPlayerName": "Anatoly Karpov",
  "whitePlayerId": "11111111-1111-1111-1111-111111111111",
  "blackPlayerId": "22222222-2222-2222-2222-222222222222"
}

### 4. Make a chess move
# Example: Pawn to e4
POST {{baseUrl}}/moves/{{gameId}}
Content-Type: application/json

{
  "fromSquare": "e2",
  "toSquare": "e4",
  "sanNotation": "e4",
  "player": "WHITE",
  "moveNumber": 1
}

### 5. Register game to platform
POST {{baseUrl}}/platform/register/{{gameId}}
Content-Type: application/json

{
  "frontendUrl": "https://localhost:3333/game/{{gameId}}"
}

### 6. End game in checkmate
PATCH {{baseUrl}}/games/{{gameId}}/mate
Content-Type: application/json

{
  "winner": "WHITE",
  "finalFen": "r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5Q2/PPPP1PPP/RNB1K1NR b KQkq - 3 3",
  "totalMoves": 4
}

### 7. End game in draw
PATCH {{baseUrl}}/games/{{gameId}}/draw
Content-Type: application/json

{
  "finalFen": "8/8/8/8/8/8/k7/7K w - - 0 1",
  "totalMoves": 50,
  "endReason": "STALEMATE"
}